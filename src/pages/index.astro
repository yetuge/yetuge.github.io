---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../config';
import { groupByYear } from '../utils/site';

const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate - a.data.pubDate);
const years = groupByYear(posts);
---

<BaseLayout>
  <div class="hero mono">
    <p class="hero-line"><span class="prompt">❯</span> whoami</p>
    <p class="hero-out">
      <strong>{SITE.author}</strong><br />
      {SITE.description}
    </p>
    <p class="hero-line">
      <span class="prompt">❯</span> ls ./posts --sort=time<span class="cursor" aria-hidden="true"></span>
    </p>
  </div>

  {
    years.map(([year, yearPosts]) => (
      <section class="year-group">
        <h2 class="year-label mono"># {year}</h2>
        <div class="card-list">
          {yearPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    ))
  }

  {
    posts.length === 0 && (
      <p class="empty mono">还没有文章。把 Markdown 文件放进 src/content/posts/ 就会出现。</p>
    )
  }
</BaseLayout>

<style>
  .hero {
    margin-bottom: 2.8rem;
  }

  .hero-line {
    margin: 0.3rem 0;
    font-size: 0.9375rem;
    color: var(--text);
  }

  .hero-out {
    margin: 0.35rem 0 0.9rem;
    padding-left: 1.35rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .hero-out strong {
    color: var(--text);
    font-weight: 650;
  }

  .year-group + .year-group {
    margin-top: 2.4rem;
  }

  .year-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-muted);
    margin: 0 0 1rem;
  }

  .card-list {
    display: grid;
    gap: 0.9rem;
  }

  .empty {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
</style>
