---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fmtDate, readingTime, withBase } from '../../utils/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const { title, description, pubDate, updatedDate, category } = post.data;

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate - a.data.pubDate
);
const idx = posts.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? posts[idx - 1] : undefined;
const older = idx >= 0 && idx < posts.length - 1 ? posts[idx + 1] : undefined;
---

<BaseLayout title={title} description={description}>
  <article class="post">
    <header>
      <p class="crumb">~/posts/{post.id}/</p>
      <h1 class="post-title">{title}</h1>
      <div class="post-meta mono">
        <time datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time>
        {
          category && (
            <a class="meta-cat" href={withBase(`/categories/${category}/`)}>
              [{category}]
            </a>
          )
        }
        <span>{readingTime(post.body ?? '')}</span>
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      toc.length > 0 && (
        <nav class="toc" aria-label="文章目录">
          <p class="toc-title mono">
            <span class="prompt">$</span> 目录
          </p>
          <ol>
            {toc.map((h) => (
              <li class={h.depth === 3 ? 'lv3' : 'lv2'}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <footer class="post-footer">
      {
        updatedDate && (
          <p class="updated mono">最后更新于 {fmtDate(updatedDate)}</p>
        )
      }
      <nav class="post-nav mono" aria-label="相邻文章">
        {
          newer ? (
            <a class="nav-newer" href={withBase(`/posts/${newer.id}/`)}>
              <span class="dir">next</span> {newer.data.title}
            </a>
          ) : (
            <span></span>
          )
        }
        {
          older && (
            <a class="nav-older" href={withBase(`/posts/${older.id}/`)}>
              <span class="dir">prev</span> {older.data.title}
            </a>
          )
        }
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-title {
    font-size: clamp(1.65rem, 4.5vw, 2.2rem);
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 0.9rem;
    letter-spacing: 0.01em;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1.1rem;
    font-size: 0.8438rem;
    color: var(--text-muted);
    padding-bottom: 1.6rem;
    margin-bottom: 2.2rem;
    border-bottom: 1px solid var(--border);
  }

  .meta-cat {
    color: var(--accent);
  }

  .meta-cat:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .updated {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0 0 2rem;
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
  }

  .post-nav a {
    display: block;
    max-width: 46%;
    color: var(--text-muted);
    transition: color 0.15s;
  }

  .post-nav a:hover {
    color: var(--accent);
  }

  .dir {
    display: block;
    font-size: 0.75rem;
    color: var(--accent);
    margin-bottom: 0.15rem;
  }

  .nav-older {
    margin-left: auto;
    text-align: right;
  }

  /* ---------- 目录导航：宽屏固定在正文右侧 ---------- */
  .toc {
    display: none;
  }

  @media (min-width: 80rem) {
    .toc {
      display: block;
      position: fixed;
      top: 6rem;
      left: calc(50% + 23.5rem + 2rem);
      width: 13.5rem;
      max-height: calc(100vh - 9rem);
      overflow-y: auto;
      font-size: 0.8125rem;
    }
  }

  .toc-title {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0 0 0.55rem;
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }

  .toc a {
    display: block;
    padding: 0.3rem 0.2rem 0.3rem 0.9rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--text-muted);
    line-height: 1.5;
    overflow-wrap: anywhere;
    transition: color 0.15s, border-color 0.15s;
  }

  .toc a:hover {
    color: var(--text);
  }

  .toc a.active {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  .toc li.lv3 a {
    padding-left: 1.7rem;
    font-size: 0.7813rem;
  }

  .toc::-webkit-scrollbar {
    width: 6px;
  }

  .toc::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 3px;
  }
</style>

<script>
  // 目录滚动高亮：取滚动线（视口顶部 120px）上方最近的标题；滚到页底时点亮最后一项
  const toc = document.querySelector('.toc');
  if (toc) {
    const links = [...toc.querySelectorAll('a[href^="#"]')];
    const byId = new Map(links.map((a) => [a.getAttribute('href').slice(1), a]));
    const headings = [...document.querySelectorAll('.prose h2, .prose h3')].filter((h) =>
      byId.has(h.id)
    );
    if (headings.length > 0) {
      let activeId = '';
      const setActive = (id: string) => {
        if (id === activeId) return;
        activeId = id;
        for (const [key, link] of byId) link.classList.toggle('active', key === id);
      };
      const onScroll = () => {
        let current = headings[0].id;
        for (const h of headings) {
          if (h.getBoundingClientRect().top > 120) break;
          current = h.id;
        }
        const atBottom =
          window.innerHeight + window.scrollY >=
          document.documentElement.scrollHeight - 2;
        if (atBottom) current = headings[headings.length - 1].id;
        setActive(current);
      };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });
      onScroll();
    }
  }
</script>
