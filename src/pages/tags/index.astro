---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagPill from '../../components/TagPill.astro';
import { countBy } from '../../utils/site';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const tags = [...countBy(posts, 'tags')].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'));
---

<BaseLayout title="标签" description="按标签浏览全部文章。">
  <p class="crumb">~/tags/</p>
  <h1 class="page-title">标签</h1>

  <div class="tag-cloud">
    {
      tags.map(([tag, count]) => (
        <span class="tag-item">
          <TagPill tag={tag} link />
          <span class="count mono">× {count}</span>
        </span>
      ))
    }
  </div>

  {tags.length === 0 && <p class="empty mono">还没有任何标签。</p>}
</BaseLayout>

<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    align-items: center;
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .count {
    font-size: 0.7813rem;
    color: var(--text-muted);
  }

  .empty {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
</style>
