---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('缺少 src/content/pages/about.md');
const { Content } = await render(about);
---

<BaseLayout title="关于" description={about.data.description}>
  <p class="crumb">~/about/</p>
  <h1 class="page-title">{about.data.title}</h1>
  <div class="prose">
    <Content />
  </div>
</BaseLayout>
