---
import { SITE, SITE_START_YEAR } from '../config';
import { withBase } from '../utils/site';

const year = new Date().getFullYear();
const yearRange = year > SITE_START_YEAR ? `${SITE_START_YEAR}–${year}` : `${year}`;
/** 页脚格言：想换就改这一行 */
const motto = '我们都在阴沟里，但仍有人仰望星空。';
---

<footer class="site-footer">
  <div class="shell">
    <p class="motto">「{motto}」</p>
    <div class="footer-inner mono">
      <span>&copy; {yearRange} {SITE.author}</span>
      <span class="footer-links">
        <a href={withBase('/rss.xml')}>rss</a>
        <a href={withBase('/sitemap-index.xml')}>sitemap</a>
        {
          SITE.links.github && (
            <a href={SITE.links.github} target="_blank" rel="noopener noreferrer">
              github
            </a>
          )
        }
        <span class="exit">exit 0</span>
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
  }

  .motto {
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
    padding: 1.4rem 1rem 0;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.2rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .footer-links {
    display: flex;
    gap: 1.1rem;
  }

  .footer-links a {
    color: var(--text-muted);
    transition: color 0.15s;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .exit {
    color: var(--border-strong);
    user-select: none;
  }
</style>
