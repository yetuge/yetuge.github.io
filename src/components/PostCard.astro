---
import type { CollectionEntry } from 'astro:content';
import { withBase, fmtDate } from '../utils/site';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, category } = post.data;
---

<article class="post-card">
  <a class="card-link" href={withBase(`/posts/${post.id}/`)}>
    <div class="card-meta mono">
      <time datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time>
      {category && <span class="card-cat">[{category}]</span>}
    </div>
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
    {
      tags.length > 0 && (
        <div class="card-tags mono" aria-label="标签">
          {tags.map((tag) => (
            <span>#{tag}</span>
          ))}
        </div>
      )
    }
  </a>
</article>

<style>
  .post-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s;
  }

  .post-card:hover {
    border-color: var(--accent);
  }

  .card-link {
    display: block;
    padding: 1.05rem 1.3rem 1.15rem;
    height: 100%;
  }

  .card-meta {
    display: flex;
    gap: 0.9rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .card-cat {
    color: var(--accent);
  }

  .card-title {
    font-size: 1.0625rem;
    font-weight: 650;
    line-height: 1.5;
    margin: 0.35rem 0 0.3rem;
  }

  .post-card:hover .card-title {
    color: var(--accent);
  }

  .post-card:hover .card-title::before {
    content: "❯ ";
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.85em;
  }

  .card-desc {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.75;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    margin-top: 0.7rem;
    font-size: 0.7813rem;
    color: var(--text-muted);
  }
</style>
