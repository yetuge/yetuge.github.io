---
import type { CollectionEntry } from 'astro:content';
import { withBase, fmtDate } from '../utils/site';
import TagPill from './TagPill.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, category } = post.data;
---

<article class="post-card">
  <a class="card-link" href={withBase(`/posts/${post.id}/`)}>
    <div class="card-meta mono">
      <time datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time>
      {/* 分类用纯文本：外层已是 <a>，锚点不可嵌套 */}
      {category && <span class="card-cat">[{category}]</span>}
    </div>
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
    {
      tags.length > 0 && (
        <div class="card-tags">
          {tags.map((tag) => (
            <TagPill tag={tag} />
          ))}
        </div>
      )
    }    <span class="card-arrow mono" aria-hidden="true">→</span>
  </a>
</article>

<style>
  .post-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .post-card:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-3px);
  }

  .card-link {
    display: block;
    position: relative;
    padding: 1.25rem 1.5rem 1.35rem;
    height: 100%;
  }

  .card-meta {
    display: flex;
    gap: 0.9rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .card-cat {
    color: var(--accent);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.5;
    margin: 0.45rem 0 0.35rem;
    transition: color 0.15s;
  }

  .post-card:hover .card-title {
    color: var(--accent);
  }

  .card-desc {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.75;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.8rem;
  }

  .card-arrow {
    position: absolute;
    right: 1.4rem;
    top: 1.4rem;
    color: var(--border-strong);
    font-size: 0.9375rem;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.2s, transform 0.2s, color 0.2s;
  }

  .post-card:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--accent);
  }
</style>
