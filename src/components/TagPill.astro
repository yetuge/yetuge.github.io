---
/**
 * 彩色标签胶囊：颜色由标签名哈希稳定决定，同一名词全站同色。
 */
interface Props {
  tag: string;
  link?: boolean;
}

const { tag, link = false } = Astro.props;
const palette = ['var(--pill-1)', 'var(--pill-2)', 'var(--pill-3)', 'var(--pill-4)', 'var(--pill-5)'];
let h = 0;
for (let i = 0; i < tag.length; i++) h = (h * 31 + tag.charCodeAt(i)) >>> 0;
const color = palette[h % palette.length];
---

{
  link ? (
    <a class="tag-pill-link" href={`/tags/${tag}/`}>
      <span class="tag-pill" style={`--pill-c: ${color}`}>
        #{tag}
      </span>
    </a>
  ) : (
    <span class="tag-pill" style={`--pill-c: ${color}`}>
      #{tag}
    </span>
  )
}

<style>
  .tag-pill-link {
    display: inline-flex;
    border-radius: 999px;
  }
</style>
